{
  "info": {
    "name": "Enviro365 Investment Backend",
    "description": "Four backend routes from BACKEND_PLAN.md. Run a fresh seeded backend first. POST requests change the balance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "investorId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "2"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "email",
      "value": "alice@example.com"
    },
    {
      "key": "password",
      "value": "Enviro365!Demo2026"
    }
  ],
  "item": [
    {
      "name": "1. Prepare CSRF",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('csrfToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Sign in to demo account",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const session = pm.response.json(); pm.collectionVariables.set('accessToken', session.accessToken); pm.collectionVariables.set('investorId', session.user.investorId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Retrieve portfolio",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/investors/{{investorId}}/portfolio"
      }
    },
    {
      "name": "Create withdrawal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"amount\": 5000.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/investors/{{investorId}}/withdrawals"
      }
    },
    {
      "name": "Retrieve history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/investors/{{investorId}}/withdrawals"
      }
    },
    {
      "name": "Download CSV statement",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/investors/{{investorId}}/withdrawals/export"
      }
    },
    {
      "name": "Download filtered CSV statement",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/investors/{{investorId}}/withdrawals/export?from=2026-10-01T00:00:00&to=2026-10-31T23:59:59.999999999"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}
